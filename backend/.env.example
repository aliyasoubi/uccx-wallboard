# ======================
# Application Settings
# ======================

PORT=3001
NODE_ENV=development              # development | production | test
DATA_SOURCE=mock                  # mock | uccx

# ======================
# UCCX API Configuration
# ======================

UCCX_QUEUE_STATS_URL=http://uccx.example.com:9080/realtime/VoiceIAQStats
UCCX_AGENT_STATS_URL=http://uccx.example.com:9080/realtime/ResourceIAQStats
UCCX_CALL_STATS_URL=http://uccx.example.com:9080/realtime/CallsStatsEndpoint
UCCX_API_USER=your-uccx-username
UCCX_API_PASS=your-uccx-password

UCCX_POLLING_INTERVAL=30000       # In milliseconds (default: 30000)
UCCX_RETRY_ATTEMPTS=3             # Max retry attempts for API calls
UCCX_RETRY_DELAY=1000             # Delay between retries in milliseconds

# ======================
# Redis Configuration
# ======================

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password
REDIS_DB=0
REDIS_TTL=60                      # Cache TTL in seconds

# ======================
# SQL Database (optional/future)
# ======================

DB_HOST=192.168.100.212
DB_PORT=1433
DB_USER=hruseruccx
DB_PASS=strongPass

# ======================
# JWT Authentication
# ======================

JWT_SECRET=c20508c91ecfe10b0a1919b517ad57ceba1e749b6f26d12c7a7d579d44453b1e
JWT_EXPIRES_IN=2d                 # e.g. 1h, 2d

# ======================
# Logging
# ======================

LOG_LEVEL=info                    # error | warn | info | debug